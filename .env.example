# Get a key at https://firecrawl.dev
FIRECRAWL_API_KEY=your_firecrawl_api_key

# Optional — only needed to scrape LinkedIn job postings (Firecrawl refuses
# linkedin.com). Sign up at https://brightdata.com/cp/start, create a
# "LinkedIn job listings information" scraper (collect by URL) under your
# account, and copy the API key + dataset_id it gives you. Without this set,
# LinkedIn results just fall back to the search snippet.
BRIGHTDATA_API_KEY=your_brightdata_api_key
BRIGHTDATA_LINKEDIN_JOBS_DATASET_ID=gd_lpfll7v5hcqtkxl6l
